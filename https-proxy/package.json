{
  "name": "https-proxy",
  "version": "1.0.0",
  "private": true,
  "description": "Local HTTP/HTTPS request-observing proxy (forward + log only, no rewriting)",
  "main": "proxy.js",
  "type": "commonjs",
  "scripts": {
    "start": "node proxy.js",
    "cert": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/generate-cert.ps1",
    "trust-ca": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/trust-ca.ps1"
  },
  "engines": {
    "node": ">=18"
  }
}
