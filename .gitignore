# --- dependencies ---
node_modules/

# --- build output ---
*.exe
*.exe~
opencode-proxy-go/opencode-proxy-go

# --- logs（代理抓包日志含完整 header/body/token/API key，绝不入库） ---
*.log
*.log.*
logs/
https-proxy/proxy.log
https-proxy/proxy-*.log

# --- proxy capture artifacts（可能含明文请求体） ---
*.jsonl

# --- replay / capture evidence（本地抓包产物，不入库；需要时另行导出） ---
data/

# --- local CA / cert backups（含私钥，绝不入库） ---
https-proxy/certs.backup-*/
https-proxy/certs/
certs*/
*certs*.bak

# --- local agent state（WorkBuddy / CodeBuddy 会话与日志） ---
.workbuddy-ai/
.workbuddy/
.codebuddy/

# --- env / secrets ---
.env
.env.*
!.env.example

# --- proprietary prompt dumps（第三方转储，不入库） ---
opencode_*system_prompt*.txt

# --- local tool-face override（opencode-proxy-go 侧本地覆盖，不入库；仓库根那份 opencode_tools.json 是自带基线，跟踪） ---
/opencode-proxy-go/opencode_tools.json

# --- generated TLS material（含私钥，绝不入库） ---
certs/
.ca/
*.pem
*.key
*.crt
*.cer
*.pfx
*.p12
*.jks

# --- runtime data（SQLite 及其临时文件，任意层级） ---
*.db
*.db-*
*.sqlite
*.sqlite-*

# --- local backups ---
.backups/
**/.backups/
*.bak
*.bak-*

# --- local agent / tooling（个人环境配置，不入库） ---
.aicli/

# --- editor / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
